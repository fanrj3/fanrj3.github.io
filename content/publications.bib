@unpublished{ye2026epbevplus,
  selected = {true},
  title = {EP-BEV+: A Robust Cross-View Geolocalization Network via Panoramic–Feature BEV Collaboration},
  author = {Ruijie Fan# and Leyan Ou# and Junyan Ye and Weijia Li*},
  year = {2026},
  month = jun,
  status = {under-review},
  abstract = {Cross-view geo-localization (CVGL) remains highly challenging due to the substantial viewpoint and structural discrepancies between ground-level panoramas and aerial imagery. While recent Bird's-Eye-View (BEV) mapping methods help bridge this domain gap, they often rely on a planar ground assumption, which can introduce boundary distortions and reduce vertical-structure cues (e.g., building facades) in dense urban environments. To address these limitations, we propose EP-BEV+, a CVGL framework that improves cross-view geometric modeling and multi-branch collaboration. Specifically, we introduce EP-BEV++, a curved-surface BEV projection mechanism that better preserves facade-level geometric cues and alleviates peripheral stretching. To reduce overfitting to dataset-specific appearance statistics, we propose a Cross-Loss Contrastive Learning (CCL) strategy that uses reference-side stochastic augmentations to encourage satellite-view invariance and robust query-to-reference alignment. To evaluate global-scale robustness and cross-region generalization, we introduce CVGlobal V2, an expanded benchmark that adds 13 test cities and expands the overall benchmark to 20 cities with heterogeneous urban morphologies worldwide. Extensive experiments show that EP-BEV+ achieves competitive or state-of-the-art performance on standard datasets (CVUSA, CVACT, and VIGOR) and shows strong transferability in challenging cross-city and cross-time scenarios.},
  preview = {epbevplus_pipeline.png},
  showbibtex = {false}
}

@misc{fan2026geomoe,
  selected={true},
  title = {One Query, Many Scales: Sparse Mixture-of-Experts for Efficient Hierarchical Cross-View Geo-Localization},
  author = {Ruijie Fan and Junyan Ye and Qi Zhu and Weijia Li*},
  year = {2026},
  month = aug,
  journal = {arXiv preprint arXiv:2608.01060},
  eprint = {2608.01060},
  archivePrefix = {arXiv},
  primaryClass = {cs.CV},
  url = {https://arxiv.org/pdf/2608.01060},
  abstract = {Cross-view geo-localization retrieves geo-tagged satellite imagery for a ground-view query. GeoMoE is a sparse mixture-of-experts dual encoder that decouples global multi-scale representation learning from local hierarchical search. Global multi-scale supervision and content-adaptive routing map ground and satellite images across resolutions into a globally comparable embedding space, while probabilistic beam search follows parent-child links to score a compact candidate subset. The work also introduces VIGOR-M, a four-city benchmark with an explicit multi-resolution satellite hierarchy.},
  description = {A sparse multi-scale dual encoder with probabilistic coarse-to-fine search, introduced together with the VIGOR-M benchmark.},
  preview = {geomoe_overview.png},
  keywords = {Cross-View Geo-Localization, Mixture-of-Experts, Hierarchical Retrieval, Remote Sensing, VIGOR-M},
  project = {https://fanrj3.github.io/GeoMoE/},
  code = {https://github.com/fanrj3/GeoMoE},
  dataset = {https://huggingface.co/datasets/Frank0666/VIGOR-M}
}

@article{fan2025raster,
  selected={true},
  title = {A Raster-Based Method for Building Simplification Considering Shape and Texture Features Based on Remote Sensing Images},
  author = {Ruijie Fan and Yilang Shen},
  year = {2025},
  month = oct,
  journal = {Geo-spatial Information Science},
  pages = {1--21},
  publisher = {Taylor \& Francis},
  doi = {10.1080/10095020.2025.2573369},
  abstract = {Building simplification involves the process of reducing the complexity of building shapes and details, which is crucial for preserving key features, highlighting essential information, and enhancing map readability. This study proposes a raster-based method for the simplification and texturing of buildings in remote sensing imagery. The method begins with segmenting preprocessed individual raster data buildings using SEEDS superpixel segmentation. Superpixels to be retained are then selected based on corner ratio (CR) and square ratio (SR). Subsequently, the building area texture is extracted, and suitable textures from the texture library are selected through texture feature comparison (TFC). Compared to traditional raster-based building simplification methods, this superpixel-based approach provides more suitable textures for simplified structures.},
  description={A superpixel-based approach for building simplification and texturing in remote sensing imagery, enhancing map generalization quality.},
  preview={raster_building_pipeline.png},
  keywords={Remote Sensing, Building Simplification, Map Generalization, Superpixel Segmentation},
  code={https://doi.org/10.1080/10095020.2025.2573369}
}

@inproceedings{fan2025satsam2,
  selected={true},
  title = {SatSAM2: Motion-Constrained Video Object Tracking in Satellite Imagery using Promptable SAM2 and Kalman Priors},
  author = {Ruijie Fan and Junyan Ye and Huan Chen and Zilong Huang and Xiaolei Wang and Weijia Li},
  year = {2025},
  month = nov,
  booktitle = {arXiv},
  abstract = {Existing satellite video tracking methods often struggle with generalization, requiring scenario-specific training to achieve satisfactory performance, and are prone to track loss in the presence of occlusion. To address these challenges, we propose SatSAM2, a zero-shot satellite video tracker built on SAM2. SatSAM2 introduces two core modules: a Kalman Filter-based Constrained Motion Module (KFCMM) to exploit temporal motion cues and suppress drift, and a Motion-Constrained State Machine (MCSM) to regulate tracking states based on motion dynamics and reliability. Extensive experiments on two satellite tracking benchmarks and a new synthetic benchmark MVOT show that SatSAM2 outperforms both traditional and foundation model-based trackers.},
  description={A zero-shot satellite video tracker built on SAM2 with Kalman Filter-based motion constraints, available on arXiv.},
  preview={satsam2_flag.png},
  keywords={Satellite Video, Object Tracking, SAM2, Kalman Filter, Remote Sensing},
  url={https://arxiv.org/abs/2511.18264}
}
